# Copie para .env e ajuste se precisar.
PORT=3000
# Endereço usado nos QR codes. Para testar no celular, use o IP do PC na rede, ex.: http://192.168.0.10:3000
PUBLIC_URL=http://localhost:3000
# Pasta onde ficam o banco, as fotos e os backups (relativa à raiz do projeto)
DATA_DIR=data
# Deixe true somente quando estiver em HTTPS (online)
COOKIE_SECURE=false
# Minutos sem uso até pedir login de novo (720 = 12 horas)
SESSAO_MINUTOS_INATIVIDADE=720
BACKUP_DIAS_RETENCAO=30
# HTTPS local (opcional). Veja o README.
# HTTPS_CERT=data/certs/cert.pem
# HTTPS_KEY=data/certs/key.pem
